{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local learning window. Files are restricted by native commands to selected course directories.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://localhost:*"
        },
        {
          "url": "http://127.0.0.1:*"
        },
        {
          "url": "http://[\\:\\:1]:*"
        }
      ]
    },
    "allow-desktop-smoke-report",
    "allow-desktop-smoke-affine",
    "allow-desktop-smoke-notion",
    "allow-desktop-smoke-notion-popup",
    "allow-confirm-asr-quit",
    "allow-asr-start",
    "allow-asr-stop",
    "allow-asr-health",
    "allow-asr-transcribe",
    "allow-asr-cancel",
    "allow-programming-environments",
    "allow-choose-programming-directory",
    "allow-run-programming",
    "allow-cancel-programming",
    "allow-frontend-ready",
    "allow-finish-close",
    "allow-affine-prepare",
    "allow-affine-layout",
    "allow-affine-ai-response",
    "allow-notion-prepare",
    "allow-notion-layout",
    "allow-notion-action",
    "allow-open-companion",
    "allow-close-companion",
    "allow-companion-is-open",
    "allow-set-companion-hit-regions",
    "allow-set-companion-fullscreen",
    "allow-reveal-learning-window",
    "allow-database-request",
    "allow-export-learning-plan",
    "allow-export-study-digest",
    "allow-publish-learning-calendar",
    "allow-subscribe-learning-calendar",
    "allow-choose-knowledge-vault",
    "allow-knowledge-vault-document",
    "allow-open-learning-resource",
    "allow-export-performance-report",
    "allow-mac-reminders-status",
    "allow-mac-reminders-export",
    "allow-mac-reminders-remove",
    "allow-pending-reminder-link",
    "allow-acknowledge-reminder-link",
    "allow-resolve-reminder-link",
    "allow-resolve-lesson-link",
    "allow-choose-course-folder",
    "allow-course-locations",
    "allow-save-course-location",
    "allow-fs-stat",
    "allow-fs-video-metadata",
    "allow-fs-entries",
    "allow-fs-child",
    "allow-fs-read",
    "allow-fs-write"
  ]
}
