{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Player",
  "version": "0.1.0",
  "identifier": "app.aiplayer.desktop",
  "build": {
    "beforeDevCommand": "npm run desktop:webdev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run desktop:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Player",
        "width": 1440,
        "height": 960,
        "minWidth": 860,
        "minHeight": 640,
        "backgroundColor": "#f9f4f2"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data: https:; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "本地视频课程与 AI 伴学",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.5"
    },
    "resources": {
      "runtime/": "runtime/"
    }
  }
}
