+import { openDB } from 'idb';
+import { IndexedDBDocStorage, IndexedDBBlobStorage } from '@affine/nbstore/idb';
+import {
+  IndexedDBV1DocStorage,
+  IndexedDBV1BlobStorage,
+} from '@affine/nbstore/idb/v1';
+import {
+  nativeBridge,
+  nativeRequest,
+  nativeKV,
+  enableNativeNotes,
+  serveNativeRequests,
+  flushNativeRequests,
+  flushNoteEngines,
+} from '@affine/nbstore/ai-player/transport';
+
+export async function prepareNotesStorage() {
+  try {
+    await initializeNotesStorage();
+  } catch (error) {
+    await nativeBridge()?.invoke('notes_storage_abort');
+    // Bootstrap failed before an editor opened; existing data is untouched.
+    (window as any).__AI_PLAYER_NOTES_FLUSH__ = async () => {};
+    throw error;
+  }
+}
+async function initializeNotesStorage() {
+  const bridge = nativeBridge();
+  if (!bridge) return;
+  const state = await bridge.invoke<{ enabled: boolean; importing: boolean }>(
+    'notes_storage_boot'
+  );
+  if (state.enabled) {
+    serveNativeRequests();
+    if (state.importing) {
+      const databases = new Set(
+        (await indexedDB.databases()).map(db => db.name)
+      );
+      const ids = new Set<string>();
+      for (const key of [
+        'affine-local-workspace',
+        'workspace-engine:local-workspace-ids:v1',
+      ]) {
+        const value = JSON.parse(localStorage.getItem(key) ?? '[]');
+        if (Array.isArray(value))
+          for (const id of value) if (typeof id === 'string') ids.add(id);
+      }
+      for (const name of databases)
+        if (name?.startsWith('local:workspace:'))
+          ids.add(name.slice('local:workspace:'.length));
+      for (const id of ids) {
+        const opts = {
+          id,
+          flavour: 'local',
+          type: 'workspace',
+          readonlyMode: true,
+        };
+        const space = `local:workspace:${id}`;
+        // Old storage is read-only until the complete import is committed.
+        const docs = [
+          new IndexedDBV1DocStorage(opts),
+          ...(databases.has(space) ? [new IndexedDBDocStorage(opts)] : []),
+        ];
+        for (const storage of docs) {
+          storage.connection.connect();
+          try {
+            await storage.connection.waitForConnected(
+              AbortSignal.timeout(20000)
+            );
+            for (const docId of Object.keys(await storage.getDocTimestamps())) {
+              const doc = await storage.getDoc(docId);
+              if (doc)
+                await nativeRequest({
+                  op: 'import',
+                  space,
+                  id: docId,
+                  bin: Array.from(doc.bin),
+                  at: doc.timestamp.getTime(),
+                });
+            }
+          } finally {
+            storage.connection.disconnect();
+          }
+        }
+        const blobs = [
+          new IndexedDBV1BlobStorage(opts),
+          ...(databases.has(space) ? [new IndexedDBBlobStorage(opts)] : []),
+        ];
+        for (const storage of blobs) {
+          storage.connection.connect();
+          try {
+            await storage.connection.waitForConnected(
+              AbortSignal.timeout(20000)
+            );
+            for (const item of await storage.list()) {
+              const blob = await storage.get(item.key);
+              if (!blob) throw new Error('笔记附件读取失败');
+              await nativeRequest({
+                op: 'blobSet',
+                space,
+                id: blob.key,
+                data: Array.from(blob.data),
+                mime: blob.mime,
+                at: blob.createdAt?.getTime(),
+              });
+            }
+          } finally {
+            storage.connection.disconnect();
+          }
+        }
+      }
+      for (const key of Object.keys(localStorage)) {
+        await nativeRequest({
+          op: 'kvSet',
+          space: 'localStorage',
+          id: key,
+          value: localStorage.getItem(key),
+        });
+      }
+      for (const [name, table, key] of [
+        ['global-storage', 'global-state', 'key'],
+        ['ai-player-note-conversations', 'sessions', 'sessionId'],
+      ]) {
+        if (!databases.has(name)) continue;
+        const db = await openDB(name);
+        try {
+          for (const value of await db.getAll(table)) {
+            await nativeKV.set(
+              name,
+              value[key],
+              name === 'global-storage' ? value.value : value
+            );
+          }
+        } finally {
+          db.close();
+        }
+      }
+      await flushNativeRequests();
+      await bridge.invoke('notes_storage_commit');
+    }
+    const values = await nativeRequest<Record<string, string>>({
+      op: 'kvList',
+      space: 'localStorage',
+    });
+    localStorage.clear();
+    for (const [key, value] of Object.entries(values))
+      localStorage.setItem(key, value);
+    const original = {
+      set: Storage.prototype.setItem,
+      remove: Storage.prototype.removeItem,
+      clear: Storage.prototype.clear,
+    };
+    const save = (op: string, id: string, value?: string) => {
+      void nativeRequest({ op, space: 'localStorage', id, value }).catch(
+        () => {}
+      );
+    };
+    Storage.prototype.setItem = function (key: string, value: string) {
+      original.set.call(this, key, value);
+      if (this === localStorage) save('kvSet', String(key), String(value));
+    };
+    Storage.prototype.removeItem = function (key: string) {
+      original.remove.call(this, key);
+      if (this === localStorage) save('kvDelete', String(key));
+    };
+    Storage.prototype.clear = function () {
+      if (this === localStorage)
+        for (const key of Object.keys(localStorage)) save('kvDelete', key);
+      original.clear.call(this);
+    };
+    enableNativeNotes();
+  }
+  (window as any).__AI_PLAYER_NOTES_FLUSH__ = async () => {
+    window.dispatchEvent(new Event('ai-player-flush-notes'));
+    await flushNoteEngines();
+    await flushNativeRequests();
+  };
+}
