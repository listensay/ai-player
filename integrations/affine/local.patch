@@ -0,0 +1,90 @@
+import { notify } from '@affine/component';
+import { router } from '@affine/core/desktop/router';
+import { AppSidebarService } from '@affine/core/modules/app-sidebar';
+import { WorkspacesService } from '@affine/core/modules/workspace';
+import type { FrameworkProvider } from '@toeverything/infra';
+
+type Lesson = { courseId: string; path: string; title: string };
+type Bridge = {
+  invoke<T>(command: string, args?: Record<string, unknown>): Promise<T>;
+};
+export function installCourseBridge(framework: FrameworkProvider) {
+  const native = (globalThis as unknown as { __TAURI__?: { core: Bridge } })
+    .__TAURI__?.core;
+  if (!native) return;
+  const service = framework.get(WorkspacesService);
+  let revision = 0;
+  let queue = Promise.resolve();
+  const open = async (lesson: Lesson | null, token: number) => {
+    if (token !== revision) return;
+    if (!lesson) {
+      (globalThis as any).currentWorkspace?.scope
+        .get(AppSidebarService)
+        .sidebar.setOpen(true);
+      return;
+    }
+    const list = await service.list.workspaces$.waitFor(list =>
+      list.some(meta => meta.flavour === 'local')
+    );
+    if (token !== revision) return;
+    const key = `ai-player:lesson:${JSON.stringify([lesson.courseId, lesson.path])}`;
+    let saved: { workspaceId: string; docId: string } | undefined;
+    try {
+      saved = JSON.parse(localStorage.getItem(key) ?? 'null') ?? undefined;
+    } catch {
+      /* no valid binding */
+    }
+    const meta =
+      list.find(
+        meta => meta.id === saved?.workspaceId && meta.flavour === 'local'
+      ) ?? list.find(meta => meta.flavour === 'local');
+    if (!meta) throw new Error('本机笔记工作区未准备好');
+    const { workspace, dispose } = service.open({ metadata: meta });
+    try {
+      await workspace.engine.doc.waitForDocReady(workspace.id);
+      let docId = saved?.workspaceId === meta.id ? saved.docId : undefined;
+      if (!docId || !workspace.docCollection.getDoc(docId)) {
+        docId = workspace.docs.createDoc({
+          title: lesson.title.slice(0, 160),
+          primaryMode: 'page',
+        }).id;
+        // A newly created local doc has no remote update to mark it ready.
+        await workspace.engine.doc.waitForDocLoaded(docId);
+        await workspace.engine.doc.waitForUpdated(docId);
+        localStorage.setItem(
+          key,
+          JSON.stringify({ workspaceId: meta.id, docId })
+        );
+      }
+      if (token !== revision) return;
+      await router.navigate(
+        `/workspace/${encodeURIComponent(meta.id)}/${encodeURIComponent(docId)}`
+      );
+      if (token === revision)
+        workspace.scope.get(AppSidebarService).sidebar.setOpen(false);
+    } finally {
+      dispose();
+    }
+  };
+  const refresh = async () => {
+    const token = ++revision;
+    try {
+      const lesson = await native.invoke<Lesson | null>(
+        'affine_lesson_context'
+      );
+      if (token !== revision) return;
+      queue = queue.catch(() => {}).then(() => open(lesson, token));
+      await queue;
+    } catch (error) {
+      if (token === revision)
+        notify.error({
+          title: '课节笔记未能打开',
+          message: error instanceof Error ? error.message : String(error),
+        });
+    }
+  };
+  window.addEventListener('ai-player-open-lesson', () => {
+    void refresh();
+  });
+  void refresh();
+}
