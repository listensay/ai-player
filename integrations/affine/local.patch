@@ -0,0 +1,115 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import {
+  nativeRequest,
+  nativeKV,
+  flushNativeRequests,
+  registerNotesFlush,
+  flushNoteEngines,
+} from './transport';
+
+test('native writes keep their order and the flush waits for the last write', async () => {
+  const calls: string[] = [];
+  (globalThis as any).__TAURI__ = {
+    core: {
+      invoke: async (_command: string, { request }: any) => {
+        if (request.value === 'first')
+          await new Promise(resolve => setTimeout(resolve, 20));
+        calls.push(request.value);
+      },
+    },
+  };
+  const first = nativeRequest({
+    op: 'kvSet',
+    space: 'meta',
+    id: 'a',
+    value: 'first',
+  });
+  const second = nativeRequest({
+    op: 'kvSet',
+    space: 'meta',
+    id: 'a',
+    value: 'second',
+  });
+  await flushNativeRequests();
+  await Promise.all([first, second]);
+  assert.deepEqual(calls, ['first', 'second']);
+});
+
+test('a failed edit is retried without discarding a subsequent CRDT update', async () => {
+  let offline = true;
+  const saved: number[] = [];
+  (globalThis as any).__TAURI__ = {
+    core: {
+      invoke: async (_command: string, { request }: any) => {
+        if (offline) throw new Error('offline');
+        saved.push(request.bin[0]);
+      },
+    },
+  };
+  await assert.rejects(
+    nativeRequest({ op: 'push', space: 's', id: 'd', bin: [1] })
+  );
+  offline = false;
+  await nativeRequest({ op: 'push', space: 's', id: 'd', bin: [2] });
+  await flushNativeRequests();
+  assert.deepEqual(saved, [2, 1]);
+});
+
+test('a newer metadata deletion supersedes an older failed set', async () => {
+  let offline = true;
+  const saved: string[] = [];
+  (globalThis as any).__TAURI__ = {
+    core: {
+      invoke: async (_command: string, { request }: any) => {
+        if (offline) throw new Error('offline');
+        saved.push(request.op);
+      },
+    },
+  };
+  await assert.rejects(nativeKV.set('metadata', 'lesson', { id: 'obsolete' }));
+  offline = false;
+  await nativeKV.set('metadata', 'lesson', undefined);
+  await flushNativeRequests();
+  assert.deepEqual(saved, ['kvDelete']);
+});
+
+test('flush waits for open editors and unregisters disposed editors', async () => {
+  let saved = false;
+  const dispose = registerNotesFlush(async () => {
+    await new Promise(resolve => setTimeout(resolve, 10));
+    saved = true;
+  });
+  await flushNoteEngines();
+  assert.equal(saved, true);
+  dispose();
+  saved = false;
+  await flushNoteEngines();
+  assert.equal(saved, false);
+});
+
+test('successful reads retain failed metadata and attachment writes for retry', async () => {
+  for (const [write, read] of [
+    ['kvSet', 'kvGet'],
+    ['blobSet', 'blobGet'],
+  ]) {
+    let offline = true;
+    const saved: string[] = [];
+    (globalThis as any).__TAURI__ = {
+      core: {
+        invoke: async (_command: string, { request }: any) => {
+          if (request.op === read) return null;
+          if (offline) throw new Error('offline');
+          saved.push(request.op);
+        },
+      },
+    };
+    await assert.rejects(
+      nativeRequest({ op: write, space: 's', id: 'pending' })
+    );
+    await nativeRequest({ op: read, space: 's', id: 'pending' });
+    offline = false;
+    await flushNativeRequests();
+    assert.deepEqual(saved, [write]);
+  }
+});
diff --git a/packages/common/nbstore/src/impls/ai-player/transport.ts b/packages/common/nbstore/src/impls/ai-player/transport.ts
new file mode 100644
index 0000000..a19ccac
--- /dev/null
+++ b/packages/common/nbstore/src/impls/ai-player/transport.ts
@@ -0,0 +1,180 @@
+type Bridge = {
+  invoke<T>(command: string, args?: Record<string, unknown>): Promise<T>;
+};
+export const nativeBridge = () =>
+  (globalThis as unknown as { __TAURI__?: { core: Bridge } }).__TAURI__?.core;
+let enabled = false;
+export const nativeNotesEnabled = () => enabled;
+export const enableNativeNotes = () => {
+  enabled = true;
+};
+const CHANNEL = 'ai-player-native-notes';
+let workerChannel: BroadcastChannel | undefined;
+const pending = new Map<
+  string,
+  {
+    resolve: (v: unknown) => void;
+    reject: (e: Error) => void;
+    timer: ReturnType<typeof setTimeout>;
+  }
+>();
+const writes = new Set<Promise<unknown>>();
+const engines = new Set<() => Promise<void>>();
+export function registerNotesFlush(flush: () => Promise<void>) {
+  engines.add(flush);
+  return () => {
+    engines.delete(flush);
+  };
+}
+export async function flushNoteEngines() {
+  await Promise.all([...engines].map(flush => flush()));
+}
+const failed = new Map<string, () => Promise<unknown>>();
+let queue = Promise.resolve<unknown>(undefined);
+export function track<T>(promise: Promise<T>): Promise<T> {
+  writes.add(promise);
+  void promise
+    .catch(e => {
+      if (typeof window !== 'undefined')
+        window.dispatchEvent(
+          new CustomEvent('ai-player-storage-error', {
+            detail: e instanceof Error ? e.message : String(e),
+          })
+        );
+    })
+    .finally(() => writes.delete(promise));
+  return promise;
+}
+export async function flushNativeRequests() {
+  while (writes.size) await Promise.all([...writes]);
+  for (const retry of [...failed.values()]) await retry();
+  while (writes.size) await Promise.all([...writes]);
+}
+export function nativeRequest<T = unknown>(
+  request: Record<string, unknown>,
+  retryKey?: string
+): Promise<T> {
+  const bridge = nativeBridge();
+  if (bridge) {
+    const task = queue.then(() =>
+      bridge.invoke<T>('notes_store_request', { request })
+    );
+    const op = String(request.op);
+    const isWrite =
+      /^(push|import|setSnapshot|merge|deleteDoc|blobSet|blobDelete|blobRelease|kvSet|kvDelete)$/.test(
+        op
+      );
+    const group = op.startsWith('kv')
+      ? 'kv'
+      : op.startsWith('blob')
+        ? 'blob'
+        : 'doc';
+    const prefix = JSON.stringify([group, request.space, request.id]);
+    const key =
+      retryKey ??
+      (op === 'push' || op === 'import'
+        ? `${prefix}:${crypto.randomUUID()}`
+        : `${prefix}:${group === 'doc' ? op : 'value'}`);
+    const checked = task.then(
+      value => {
+        if (isWrite) failed.delete(key);
+        if (op === 'deleteDoc')
+          for (const pendingKey of failed.keys())
+            if (pendingKey.startsWith(prefix + ':')) failed.delete(pendingKey);
+        return value;
+      },
+      error => {
+        if (isWrite) failed.set(key, () => nativeRequest(request, key));
+        throw error;
+      }
+    );
+    queue = checked.catch(() => {});
+    return track(checked);
+  }
+  if (!workerChannel) {
+    workerChannel = new BroadcastChannel(CHANNEL);
+    workerChannel.onmessage = event => {
+      const reply = event.data;
+      if (reply.type !== 'result') return;
+      const entry = pending.get(reply.id);
+      if (!entry) return;
+      pending.delete(reply.id);
+      clearTimeout(entry.timer);
+      if (reply.error) entry.reject(new Error(reply.error));
+      else entry.resolve(reply.value);
+    };
+  }
+  return new Promise<T>((resolve, reject) => {
+    const id = crypto.randomUUID();
+    const timer = setTimeout(() => {
+      pending.delete(id);
+      reject(new Error('笔记保存超时'));
+    }, 20000);
+    pending.set(id, {
+      resolve: resolve as (v: unknown) => void,
+      reject,
+      timer,
+    });
+    workerChannel!.postMessage({ type: 'request', id, request });
+  });
+}
+export function serveNativeRequests() {
+  const channel = new BroadcastChannel(CHANNEL);
+  channel.onmessage = event => {
+    const data = event.data;
+    if (data.type !== 'request' || typeof data.id !== 'string') return;
+    void nativeRequest(data.request).then(
+      value => channel.postMessage({ type: 'result', id: data.id, value }),
+      error =>
+        channel.postMessage({
+          type: 'result',
+          id: data.id,
+          error: String(error.message || error),
+        })
+    );
+  };
+}
+export const nativeKV = {
+  async get<T>(space: string, id: string): Promise<T | undefined> {
+    const value = await nativeRequest<string | null>({
+      op: 'kvGet',
+      space,
+      id,
+    });
+    return value === null ? undefined : (JSON.parse(value) as T);
+  },
+  async set(space: string, id: string, value: unknown) {
+    await nativeRequest(
+      value === undefined
+        ? { op: 'kvDelete', space, id }
+        : { op: 'kvSet', space, id, value: JSON.stringify(value) }
+    );
+  },
+  async all<T>(space: string): Promise<Record<string, T>> {
+    const values = await nativeRequest<Record<string, string>>({
+      op: 'kvList',
+      space,
+    });
+    return Object.fromEntries(
+      Object.entries(values).map(([k, v]) => [k, JSON.parse(v) as T])
+    );
+  },
+};
+
+export function trackNoteWrite<T>(
+  key: string,
+  write: () => Promise<T>
+): Promise<T> {
+  return track(
+    write().then(
+      value => {
+        failed.delete(key);
+        return value;
+      },
+      error => {
+        failed.set(key, () => trackNoteWrite(key, write));
+        throw error;
+      }
+    )
+  );
+}
