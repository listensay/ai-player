@@ -0,0 +1,127 @@
+import 'fake-indexeddb/auto';
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+(globalThis as any).BUILD_CONFIG = {
+  appVersion: '0.27.4',
+  appBuildType: 'stable',
+  debug: false,
+};
+const { localQuery, executeLocal } = await import('./ai-player-local');
+const gql = await import('@affine/graphql');
+async function create(workspaceId: string) {
+  const result = await localQuery({
+    query: gql.createCopilotSessionMutation,
+    variables: { options: { workspaceId, promptName: 'Chat With AFFiNE AI' } },
+  });
+  return result.createCopilotSession;
+}
+async function history(workspaceId: string) {
+  const result = await localQuery({
+    query: gql.getCopilotHistoriesQuery,
+    variables: { workspaceId, pagination: {} },
+  });
+  return result.currentUser!.copilot!.chats.edges.map(e => e.node);
+}
+test('local AI keeps messages and separates workspaces', async () => {
+  const a = await create('workspace-a');
+  await create('workspace-b');
+  let payload: any;
+  (globalThis as any).__TAURI__ = {
+    core: {
+      invoke: async (_cmd: string, args: any) => {
+        payload = args;
+        return '总结结果';
+      },
+    },
+  };
+  const chunks = [];
+  for await (const text of executeLocal(
+    'summary',
+    { workspaceId: 'workspace-a', input: '测试笔记' } as any,
+    a
+  ))
+    chunks.push(text);
+  assert.deepEqual(chunks, ['总结结果']);
+  assert.equal(payload.messages.at(-1).content, '测试笔记');
+  assert.match(payload.prompt, /总结/);
+  const [saved] = await history('workspace-a');
+  assert.deepEqual(
+    saved.messages.map(m => [m.role, m.content]),
+    [
+      ['user', '测试笔记'],
+      ['assistant', '总结结果'],
+    ]
+  );
+  assert.equal((await history('workspace-b'))[0].messages.length, 0);
+  await localQuery({
+    query: gql.cleanupCopilotSessionMutation,
+    variables: { input: { workspaceId: 'workspace-b', sessionIds: [a] } },
+  });
+  assert.equal((await history('workspace-a')).length, 1);
+});
+test('cancelled AI sends cancellation and discards a late result', async () => {
+  const session = await create('cancel-workspace');
+  const controller = new AbortController();
+  let resolveResponse!: (text: string) => void;
+  let started!: () => void;
+  const requestStarted = new Promise<void>(resolve => {
+    started = resolve;
+  });
+  const commands: string[] = [];
+  (globalThis as any).__TAURI__ = {
+    core: {
+      invoke: (cmd: string) => {
+        commands.push(cmd);
+        if (cmd === 'affine_ai_cancel') return Promise.resolve();
+        started();
+        return new Promise<string>(resolve => {
+          resolveResponse = resolve;
+        });
+      },
+    },
+  };
+  const consume = (async () => {
+    for await (const _chunk of executeLocal(
+      'chat',
+      {
+        workspaceId: 'cancel-workspace',
+        input: '取消测试',
+        signal: controller.signal,
+      } as any,
+      session
+    )) {
+    }
+  })();
+  await requestStarted;
+  controller.abort();
+  resolveResponse('迟到结果');
+  await assert.rejects(consume, { name: 'AbortError' });
+  assert.ok(commands.includes('affine_ai_cancel'));
+  assert.equal((await history('cancel-workspace'))[0].messages.length, 1);
+});
+test('explicit image attachments reach the shared model bridge', async () => {
+  const session = await create('image-workspace');
+  let messages: any;
+  (globalThis as any).__TAURI__ = {
+    core: {
+      invoke: async (_cmd: string, args: any) => {
+        messages = args.messages;
+        return '图片结果';
+      },
+    },
+  };
+  for await (const _ of executeLocal(
+    'explainImage',
+    {
+      workspaceId: 'image-workspace',
+      input: '解释图片',
+      attachments: [
+        new Blob([new Uint8Array([137, 80, 78, 71])], { type: 'image/png' }),
+      ],
+    } as any,
+    session
+  )) {
+  }
+  assert.equal(messages.at(-1).images[0].mediaType, 'image/png');
+  assert.equal(messages.at(-1).images[0].data, 'iVBORw==');
+});
