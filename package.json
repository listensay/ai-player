{
  "name": "ai-player",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "build": "vue-tsc --noEmit && vite build",
    "dev": "tauri dev",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:frontend": "node scripts/desktop-frontend.mjs build",
    "desktop:webdev": "node scripts/desktop-frontend.mjs dev",
    "tauri": "tauri",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "benchmark": "node scripts/benchmark.mjs",
    "test:ui": "node --test tests/playerLayout.test.mjs tests/playerDirectory.test.mjs tests/notion.test.mjs tests/companion-interactions.test.mjs",
    "ui:prepare": "node scripts/prepare-ui-fixture.mjs",
    "ui:build": "tauri build --debug --bundles app --config tests/fixtures/ui-regression.json",
    "ui:pomodoro": "tauri build --debug --bundles app --config tests/fixtures/pomodoro-test.json",
    "smoke:frontend": "node scripts/desktop-frontend.mjs smoke",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "benchmark:check": "node scripts/benchmark.mjs .cache/performance.json --check",
    "bundle:check": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@lucide/vue": "^1.48.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-http": "^2.6.1",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "ffmpeg-static": "^5.3.0",
    "markdown-it": "^15.0.2",
    "monaco-editor": "^0.57.0",
    "quickjs-emscripten-core": "^0.32.0",
    "sherpa-onnx-node": "^1.13.8",
    "tar": "^7.5.22",
    "unbzip2-stream": "^1.4.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vuetify": "^3.13.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.13.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "sass": "^1.105.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "^8.3.0",
    "vue-tsc": "^3.1.8"
  },
  "version": "0.1.0",
  "engines": {
    "node": "24.x"
  }
}
